{
  "expo": {
    "name": "Sustain",
    "slug": "healthapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalen.healthapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "healthapp",
    "plugins": [
      "expo-router",
      "./plugins/with-private-backups.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F4",
          "image": "./assets/sustain/symbol.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B1913",
            "image": "./assets/sustain/symbol.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Sustain to use Face ID to protect access to your health information."
        }
      ],
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sustain to use Face ID to protect access to your health information."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sustain to scan food barcodes and take meal or progress photos when you choose.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sustain to use meal or progress photos you select.",
          "cameraPermission": "Allow Sustain to take meal or progress photos when you choose.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sustain reads weight, blood pressure, and pulse paired with blood pressure to display your trends and sync these readings to your private Sustain account.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6276085-8eb1-4598-9856-92fe6ecc8a5d"
      }
    }
  }
}
