{
  "name": "healthapp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@healthapp/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:edge",
    "test:edge": "tsx --test supabase/functions/**/*.test.ts",
    "precheck": "npm run lint --workspaces --if-present",
    "check": "npm run typecheck --workspaces --if-present",
    "postcheck": "npm run test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2"
  }
}
